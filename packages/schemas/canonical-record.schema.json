{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RekeyZero Canonical Record Envelope",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "data"
  ],
  "properties": {
    "schema_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "data": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field_path",
          "asset_id",
          "confidence"
        ],
        "properties": {
          "field_path": {
            "type": "string"
          },
          "asset_id": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "locator": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}

{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "headless": true
    },
    "contextOptions": {
      "viewport": {
        "width": 1680,
        "height": 1050
      }
    }
  },
  "outputDir": "../../output/playwright",
  "outputMode": "stdout",
  "console": {
    "level": "warning"
  },
  "timeouts": {
    "action": 10000,
    "navigation": 60000
  },
  "allowUnrestrictedFileAccess": true,
  "codegen": "none"
}

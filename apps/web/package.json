{
  "name": "@rekeyzero/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false && vite build",
    "ui": "playwright-cli -s=rekeyzero",
    "ui:open": "playwright-cli -s=rekeyzero open http://localhost:5173 --headed",
    "ui:open:headless": "playwright-cli -s=rekeyzero open http://localhost:5173",
    "ui:snapshot": "playwright-cli -s=rekeyzero snapshot",
    "ui:screenshot": "playwright-cli -s=rekeyzero screenshot --filename=../../output/playwright/rekeyzero.png",
    "ui:close": "playwright-cli -s=rekeyzero close"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tanstack/react-query": "^5.85.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.540.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.8.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.18",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}

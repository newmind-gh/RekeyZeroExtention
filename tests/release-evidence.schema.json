{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rekeyzero.local/schemas/release-evidence.schema.json",
  "title": "RekeyZero release validation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["release", "commit", "artifact_sha256", "environment", "test", "result", "evidence"],
  "properties": {
    "release": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "browser_version", "os"],
      "properties": {
        "browser": { "enum": ["Chrome", "Edge", "Chromium"] },
        "browser_version": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "device_tier": { "enum": ["L0", "L1", "L2", "L3", "M1", "not_applicable"] },
        "portal": { "type": "string" },
        "devtools_open": { "type": "boolean" }
      }
    },
    "test": { "type": "string", "minLength": 1 },
    "result": { "enum": ["pass", "fail", "blocked", "not_applicable"] },
    "metrics": { "type": "object", "additionalProperties": { "type": ["number", "string", "boolean", "null"] } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "tester": { "type": "string" },
    "test_date": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  }
}
